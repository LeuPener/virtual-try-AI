{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/tab/home/index",
      "style": {
       "navigationBarTitleText": "AI 换装",
				"enablePullDownRefresh": false,
				"navigationBarBackgroundColor": "#fff"
      }
    },
    {
      "path": "pages/tab/list/index",
      "style": {
        "navigationBarTitleText": "生成记录"
      },
      "needLogin": true
    },
    {
      "path": "pages/tab/user/index",
      "style": {
        "navigationBarTitleText": "",
				"enablePullDownRefresh": false,
				"navigationBarBackgroundColor": "#eff2f3"
      },
      "needLogin": true
    }
  ],
  "subPackages": [
    {
      "root": "pages/common",
      "pages": [
        {
          "path": "login/index",
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "webview/index",
          "style": {
            "navigationBarTitleText": "网页"
          }
        },
        {
          "path": "404/index",
          "style": {
            "navigationBarTitleText": "404",
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
			"root": "pages/contact",
			"pages": [
				{
					"path": "index",
					"style": {
						"navigationBarTitleText": "联系客服",
						"enablePullDownRefresh": false,
						"navigationBarBackgroundColor": "#fff"
					}
				}
			]
		},
    {
			"root": "pages/points",
			"pages": [{
					"path": "index",
					"style": {
						"navigationBarTitleText": "",
						"enablePullDownRefresh": false,
						"navigationBarBackgroundColor": "#fff"
					}, 
          "needLogin": true
				},
				{
					"path": "pointsFlow/index",
					"style": {
						"navigationBarTitleText": "积分记录",
						"enablePullDownRefresh": false,
						"navigationBarBackgroundColor": "#fff"
					}
				}
			]
		},
    {
			"root": "pages/createPhoto",
			"pages": [{
				"path": "index",
				"style": {
					"navigationBarTitleText": "生成照片",
					"enablePullDownRefresh": false,
					"navigationBarBackgroundColor": "#f8f9fc"
				},
        "needLogin": true
			},
      {
				"path": "result/index",
				"style": {
					"navigationBarTitleText": "",
					"enablePullDownRefresh": false,
					"navigationBarBackgroundColor": "#fff"
				},
        "needLogin": true
			}]
		}
  ],
  "preloadRule": {
    "pages/tab/home/index": {
      "network": "all",
      "packages": ["pages/common", "pages/points", "pages/createPhoto"]
    }
  },
  "tabBar": {
    "color": "#6c6b6b",
    "selectedColor": "#6f42e8",
    "borderStyle": "white",
    "backgroundColor": "#ffffff",
    "list": [{
      "iconPath": "static/images/tabbar/home.png",
      "selectedIconPath": "static/images/tabbar/homeed.png",
      "pagePath": "pages/tab/home/index",
      "text": "首页"
    }, {
      "iconPath": "static/images/tabbar/quan.png",
      "selectedIconPath": "static/images/tabbar/quaned.png",
      "pagePath": "pages/tab/list/index",
      "text": "生成记录"
    }, {
      "iconPath": "static/images/tabbar/mine.png",
      "selectedIconPath": "static/images/tabbar/mineed.png",
      "pagePath": "pages/tab/user/index",
      "text": "我的"
    }]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
