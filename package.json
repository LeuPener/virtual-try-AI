{
  "name": "uniapp-vue3-project",
  "type": "module",
  "version": "1.3.0",
  "description": "uniapp-vue3-project",
  "author": {
    "name": "",
    "email": "",
    "github": ""
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "Vue3",
    "uniapp",
    "uniapp-vue3-template",
    "Vite5",
    "TypeScript",
    "uview-plus",
    "uniapp template",
    "UnoCSS"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "uvm": "npx @dcloudio/uvm@latest",
    "uvm-rm": "node ./scripts/post-upgrade.js",
    "dev:h5": "uni",
    "dev:h5:ssr": "uni --ssr",
    "dev:h5-test": "uni --mode test",
    "dev:h5-pro": "uni --mode production",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-weixin-test": "uni -p mp-weixin --mode test",
    "dev:mp-weixin-prod": "uni -p mp-weixin --mode production",
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "dev:app-ios": "uni -p app-ios",
    "build:h5": "uni build",
    "build:h5:ssr": "uni build --ssr",
    "build:h5-test": "uni build  --mode test",
    "build:h5-prod": "uni build  --mode production",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin-test": "uni build -p mp-weixin --mode test",
    "build:mp-weixin-prod": "uni build -p mp-weixin --mode production",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "build:app-ios": "uni build -p app-ios",
    "eslint": "eslint \"src/**/*.{js,jsx,vue}\"",
    "eslint:fix": "eslint \"src/**/*.{js,jsx,vue}\" --fix",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css,sass,less}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,scss,css,sass,less}\" --fix",
    "cz": "git add . && npx czg",
    "postinstall": "simple-git-hooks",
    "clean": "npx rimraf node_modules",
    "clean:cache": "npx rimraf node_modules/.cache"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080520251106001",
    "@dcloudio/uni-app-harmony": "3.0.0-4080520251106001",
    "@dcloudio/uni-app-plus": "3.0.0-4080520251106001",
    "@dcloudio/uni-components": "3.0.0-4080520251106001",
    "@dcloudio/uni-h5": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-alipay": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-baidu": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-harmony": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-jd": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-lark": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-qq": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4080520251106001",
    "@dcloudio/uni-mp-xhs": "3.0.0-4080520251106001",
    "@dcloudio/uni-quickapp-webview": "3.0.0-4080520251106001",
    "dayjs": "^1.11.19",
    "oxc-parser": "^0.97.0",
    "pinia": "2.2.4",
    "pinia-plugin-persistedstate": "4.1.3",
    "uview-plus": "^3.6.15",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "z-paging": "^2.8.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.13.0",
    "@dcloudio/types": "^3.4.15",
    "@dcloudio/uni-automator": "3.0.0-4080520251106001",
    "@dcloudio/uni-cli-shared": "3.0.0-4080520251106001",
    "@dcloudio/uni-stacktracey": "3.0.0-4080520251106001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080520251106001",
    "@esbuild/darwin-arm64": "0.25.4",
    "@esbuild/darwin-x64": "0.25.4",
    "@iconify-json/mdi": "^1.2.3",
    "@rollup/rollup-darwin-arm64": "4.40.2",
    "@rollup/rollup-darwin-x64": "4.40.2",
    "@unocss/eslint-plugin": "^0.63.6",
    "@unocss/preset-icons": "^0.63.6",
    "@vue/runtime-core": "^3.5.13",
    "czg": "^1.12.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.32.0",
    "lint-staged": "^16.2.6",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "1.79.6",
    "sass-loader": "^16.0.4",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^16.25.0",
    "stylelint-config-recess-order": "^6.1.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "unocss": "0.63.6",
    "unocss-preset-weapp": "^66.0.1",
    "unplugin-auto-import": "19.3.0",
    "unplugin-turbo-console": "~2.0.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "5.2.8",
    "vite-plugin-clean-build": "^1.4.1",
    "vite-plugin-replace-image-url": "^1.4.1",
    "vite-plugin-restart": "^1.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node ./scripts/verify-commit.js"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": "eslint --fix",
    "*.{scss,css,style,html}": "stylelint --fix",
    "*.vue": [
      "eslint --fix",
      "stylelint --fix"
    ]
  }
}
